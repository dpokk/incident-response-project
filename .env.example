# Copy to .env and fill in. .env is git-ignored; never commit real tokens.
# Keep this file in step with investigator/config.py and demo/agent/llm.py: every variable read there is listed here.

# --- Slack: bot token + channel (threads, in-place updates) and/or an incoming webhook (unthreaded fallback) ---
# Bot needs the chat:write scope and must be invited to the channel (/invite @your-bot). Starts with xoxb-
SLACK_BOT_TOKEN=
# Channel ID, e.g. C0123456789
SLACK_CHANNEL=
# Optional. https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=
# Also post short "incident detected" / "symptoms cleared" messages
SLACK_POST_DETECTION=true
# Human review (Iteration 6): Socket Mode app-level token (xapp-..., scope connections:write) on the same app.
# Socket Mode and Interactivity must be enabled. Without it, plans are posted but cannot be reviewed/executed.
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs allowed to approve/reject (and, by policy default, Execute). Empty = nobody.
# e.g. U0123456789,U0987654321
SLACK_APPROVERS=
# Execution of approved remediation (Iteration 7). Default: config/execution_policy.json.
# (python -m demo sets demo/execution_policy.json itself before .env is read.)
# EXECUTION_POLICY_PATH=config/execution_policy.json

# --- Target ---
TARGET_NAMESPACE=shop
KUBE_CONTEXT=incident-demo
# User-facing entry point that detection probes like a user would (via the API server proxy)
ENTRY_SERVICE=frontend
ENTRY_PORT=8080
ENTRY_PATH=/api/orders?quantity=1&total=10
ENTRY_APP=frontend

# --- Evidence sources ---
# Fixed, read-only DNS+TCP check run inside a consumer pod to test dependency connectivity
ALLOW_ACTIVE_PROBES=true
# planned = the planner follows the evidence (default); exhaustive = the fixed Iteration 2 procedure
INVESTIGATION_STRATEGY=planned
# Optional metrics enrichment from the Prometheus in k8s/ (the investigation works without it)
PROMETHEUS_ENABLED=true
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_AUTO_PORT_FORWARD=true
PROMETHEUS_NAMESPACE=monitoring
PROMETHEUS_SERVICE=prometheus

# Evidence history: a recorder (in `watch` or `record`) keeps what Kubernetes forgets in state/history.db
HISTORY_ENABLED=true
HISTORY_RETENTION_H=24
# Log lines kept per container per minute; extra lines are counted as dropped (reported, never hidden)
HISTORY_MAX_LINES_PER_MIN=3000

# --- Detection & timing ---
POLL_INTERVAL_S=5
PROBE_FAILURE_THRESHOLD=0.5
ERROR_LOG_THRESHOLD=5
ERROR_RATE_THRESHOLD=0.05
NOT_READY_GRACE_S=20
# python -m demo uses 20 (set before .env is read); the investigator CLI uses this value
INVESTIGATE_DELAY_S=40
RESOLVE_STABLE_S=45
LOOKBACK_S=300

# --- Demo console + agent (python -m demo, demo/agent/llm.py): NVIDIA NIM, OpenAI-compatible ---
# Without NVIDIA_API_KEY the agent is disabled. Starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEMO_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
DEMO_AGENT_TIMEOUT_S=90
DEMO_PORT=8800

# --- Iteration 1 only (archive/iteration1, not run by the current code) - kept for reference ---
# LLM_ENABLED=true
# LLM_PROVIDER=nvidia
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b
# LLM_TIMEOUT_S=120
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# CPU_THRESHOLD=0.9
# MEMORY_THRESHOLD=0.85
# MAX_INCIDENT_WAIT_S=600
