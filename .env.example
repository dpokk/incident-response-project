# Copy to .env and fill in. .env is git-ignored; never commit real tokens.

# --- Slack (optional delivery of reports): bot token + channel, or an incoming webhook ---
# Bot needs the chat:write scope and must be invited to the channel (/invite @your-bot)
SLACK_BOT_TOKEN=
# Channel ID, e.g. C0123456789
SLACK_CHANNEL=
SLACK_WEBHOOK_URL=
# Also post short "incident detected" / "symptoms cleared" messages
SLACK_POST_DETECTION=true
# Threads (one per incident) and in-place updates need the bot token + channel; the webhook alone posts
# unthreaded messages that cannot be updated.
# Human review (Iteration 6): Socket Mode app-level token (xapp-..., scope connections:write) on the same app.
# Enable Socket Mode and Interactivity in the app settings. Without it, plans are posted but cannot be reviewed.
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs (e.g. U0123456789) allowed to approve/reject. Empty = nobody can decide.
SLACK_APPROVERS=
# Execution of approved remediation (Iteration 7): environment/demo policy (allowed actions, namespaces, caps,
# max plan age, executors, verification window). Executors default to SLACK_APPROVERS.
# EXECUTION_POLICY_PATH=config/execution_policy.json

# --- Target ---
TARGET_NAMESPACE=shop
KUBE_CONTEXT=incident-demo
# User-facing entry point that detection probes like a user would (via the API server proxy)
ENTRY_SERVICE=frontend
ENTRY_PORT=8080
ENTRY_PATH=/api/orders?quantity=1&total=10

# --- Evidence sources ---
# Fixed, read-only DNS+TCP check run inside a consumer pod to test dependency connectivity
ALLOW_ACTIVE_PROBES=true
# planned = the planner follows the evidence (default); exhaustive = the fixed Iteration 2 procedure
INVESTIGATION_STRATEGY=planned
# Optional metrics enrichment from the Iteration 1 Prometheus (the investigation works without it)
PROMETHEUS_ENABLED=true
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_AUTO_PORT_FORWARD=true
ENTRY_APP=frontend

# Evidence history: a recorder (in `watch` or `record`) keeps what Kubernetes forgets - earlier runs' logs,
# deleted pods, expired events, earlier configuration - in state/history.db
HISTORY_ENABLED=true
HISTORY_RETENTION_H=24
# Log lines kept per container per minute; extra lines are counted as dropped (reported, never hidden)
HISTORY_MAX_LINES_PER_MIN=3000

# --- Detection & timing ---
POLL_INTERVAL_S=5
PROBE_FAILURE_THRESHOLD=0.5
ERROR_LOG_THRESHOLD=5
ERROR_RATE_THRESHOLD=0.05
NOT_READY_GRACE_S=20
INVESTIGATE_DELAY_S=40
RESOLVE_STABLE_S=45
LOOKBACK_S=300

# LLM settings (NVIDIA_*, ANTHROPIC_*) are not used by the current investigator. The Iteration 1 LLM
# code is archived in archive/iteration1. An LLM-assisted planner is a later milestone
# (docs/ROADMAP.md); it would use the capability layer, never replace the evidence.
